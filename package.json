{
  "name": "@redredgroup/samsungknox",
  "private": true,
  "version": "1.0.1",
  "repository": "https://github.com/REDREDGROUP/samsungknox.git",
  "maintainers": [
    {
      "name": "K-SEIHOON",
      "email": "seihoonkim@hansei.kr",
      "url": "https://github.com/jieey1140"
    }
  ],
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "clean": "git clean -Xdf --exclude=\"!.env.*\"",
    "format": "biome check --write .",
    "lint": "biome check .",
    "lint:format": "biome format .",
    "syncpack:fix": "syncpack fix-mismatches --config ./.syncpackrc.js --dependency-types dev,prod,peer,pnpmOverrides",
    "syncpack:format": "syncpack format --config ./.syncpackrc.js",
    "syncpack:lint": "syncpack lint --config ./.syncpackrc.js --dependency-types dev,prod,peer,pnpmOverrides",
    "syncpack:list": "syncpack list --config ./.syncpackrc.js --dependency-types dev,prod,peer,pnpmOverrides"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@types/node": "24.10.9",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "syncpack": "15.3.1",
    "turbo": "2.9.16",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.13.0",
    "pnpm": "10.28.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "disableScopeLowerCase": false,
      "disableSubjectLowerCase": false,
      "maxHeaderWidth": 100,
      "maxLineWidth": 100
    }
  },
  "packageManager": "pnpm@10.28.2"
}
